#!/usr/bin/env ruby
require 'fileutils'
include FileUtils

# path to your application root.d
APP_ROOT = File.expand_path('..', __dir__)

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

chdir APP_ROOT do
  # This script is a starting point to setup your application.
  # Add necessary setup steps to this file.

  puts '== Installing dependencies =='
  system! 'gem install bundler --conservative'
  system('bundle check') || system!('bundle install')
  print "APPNAME: "
  app_name = gets.strip
  print "PRODUCTION BASEURL: "
  production_base_url = gets.strip
  print "GITREPO starting with git@: "
  git_repo = gets.strip
  git_repo.gsub! '/', '\/'

  system("sed -i \"s/APPNAME/#{app_name}/g\" #{APP_ROOT}/config/deploy.rb")
  system("sed -i \"s/APPNAME/#{app_name}/g\" #{APP_ROOT}/config/deploy/production.rb")
  system("sed -i \"s/APPNAME/#{app_name}/g\" #{APP_ROOT}/config/deploy/staging.rb")
  system("sed -i \"s/APPNAME/#{app_name}/g\" #{APP_ROOT}/config/environments/staging.rb")

  system("sed -i \"s/BASEURL/#{production_base_url}/g\" #{APP_ROOT}/config/deploy/production.rb")
  system("sed -i \"s/BASEURL/#{production_base_url}/g\" #{APP_ROOT}/config/environments/production.rb")
  system("sed -i \"s/GITREPO/#{git_repo}/g\" #{APP_ROOT}/config/deploy.rb")

  system("git remote remove origin")
  system("git remote add origin #{git_repo}")
end
