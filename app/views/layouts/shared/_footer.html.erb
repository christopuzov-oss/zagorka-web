<%#= render partial: 'layouts/shared/gdpr' if cookies[:gdpr_cookie_consent].blank? %>
<footer class='small-12'>
  <div class='row'>
    <div class='small-12 text-center'>
      <%= image_tag "zagorka_Black&Withe_Logo_#{I18n.locale}.png", class: "icon-logo" %>
      <%# <i class='icon-logo font-55'></i> %>
    </div>
    <div class='small-6 medium-12 text-center'>
      <ul class='menu expanded categories-list'>
        <%= render partial: 'layouts/shared/menu_list' %>
      </ul>
    </div>
    <div class='small-6 medium-6 text-center'>
      <ul class='no-bullet menu align-right icons-list'>
        <li>
          <a href="<%=Rails.application.config.facebook%>" target='_blank'>
            <i class='icon-facebook'></i>
          </a>
        </li>
        <li>
          <a href="<%=Rails.application.config.youtube%>" target='_blank'>
            <i class='icon-youtube'></i>
          </a>
        </li>
        <li>
          <a href="<%=Rails.application.config.linkedin%>" target='_blank'>
            <i class='icon-linkedin'></i>
          </a>
        </li>
      </ul>
    </div>
    <div class='small-12 medium-6 text-left'>
      <ul class='menu expanded contacts-list'>
        <li> 
          <a href="/contacts">
            <i class='icon-mail'></i>
            <%= content_tag :span, t('.contacts') %>
          </a>
        </li>
        <li> 
          <a href="tel:080011330" class='telephone-link'>
            <%= image_tag 'phone-number.svg' %>
          </a>
        </li>
      </ul>
    </div>
    <div class='small-12'>
      <ul class='menu align-center tos-list font-14'>
        <% @footer_articles.each do |a| %>
          <%= content_tag :li, link_to(a.title, a.path) %>
        <% end %>
        <%= content_tag :li, link_to("Политика за поверителност", "/ZagorkaPrivacyPolicyBG_2018.pdf", target: "_blank") %>
        <%= content_tag :li, link_to("Политика за бисквитките", "/ZagorkaCookiePolicy_BG.pdf", target: "_blank") %>
        <%= content_tag :li, link_to("Сигнал за нередност", "/signals") %>
        
      </ul> 
    </div>
    <div class='small-12'>
      <ul class='menu expanded align-center tos-list font-14'>
        <li>
          <span>© 2020 Copyright ZAGORKA SA. All rights reserved.</span>
        </li>
      </ul> 
    </div>
  </div> 
</footer>