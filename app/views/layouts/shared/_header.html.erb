<header class='small-12'>
  <ul class='no-bullet show-for-large'>
    <div class='left-menu-wrapper'>
      <%= render partial: 'layouts/shared/left_menu_list' %>
    <div>
  </ul>
  <div class='logo-wrap'>
    <%= link_to image_tag('logo.svg', alt: 'logo'), root_path %>
  </div>
  <ul class='no-bullet show-for-large'>
    <%= render partial: 'layouts/shared/right_menu_list' %>
    <%= render partial: 'layouts/shared/menu_icons_list' %>
    <!--
    <li>
      <ul class="dropdown menu" data-dropdown-menu>
        <li>
          <%#=link_to I18n.locale, '#', class: 'btn-locales' %>
          <ul class="menu">
            <%#= render partial: "/layouts/shared/locales_list" %>
          </ul>
        </li>
      </ul>
    </li>
    -->
  </ul>
  <div class='hide-for-large search-button mobile-search-button no-active'>
    <%= link_to  '/' do  %>
      <%= content_tag :i, '', class: 'icon-search' %>
    <% end %>
  </div>
  <div class='hamburger-wrap hide-for-large'>
    <button class='hamburger hamburger--slider no-active' type="button" id='menuButton'>
      <span class='hamburger-box'>
        <span class='hamburger-inner'></span>
      </span>
    </button>
  </div>
</header>
<div class='small-12 search-form-wrap is-reveal-closed' id="searchForm">
  <%= render partial: 'layouts/shared/search_form' %>
</div>