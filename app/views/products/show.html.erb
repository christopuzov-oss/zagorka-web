<%= content_for(:wide) do %> 
  <% if @product.cover_picture %>
    <section class='small-12'>
      <figure class='small-12 wide-banner wallpaper' style="background-image: url(<%= @product.cover_picture_url %>)">  
        <figcaption class='small-12 medium-8 large-6'  data-aos="fade-up">
          <%#= content_tag :h1, @article.title, class: 'strong font-50' %>
        </figcaption>
        <!--
        <div class='fasha text-right small-12'>
          <i class='icon-logo font-26'></i>
        </div>  
        -->
      </figure>
    </section>
  <% end %>
<% end %>
<div class='product-page small-12'>
<div class='small-12'>
  <div class='small-12 medium-4 large-4 column float-left text-center'>
    <%= image_tag @product.picture_url %>
  </div>
  <div class='small-12 medium-8 large-8 column float-left'>
    <div class='small-12 medium-4 buttons-wrap float-right text-right'>
        <%= link_to '', @product.facebook_link,  target: '_blank', class: 'font-36 icon-facebook'  unless @product.facebook_link.to_s.empty? %>
        <%= link_to '', @product.youtube_link,   target: '_blank', class: 'font-26 icon-youtube'   unless @product.youtube_link.to_s.empty? %>
        <%= link_to '', @product.instagram_link, target: '_blank', class: 'font-36 icon-instagram' unless @product.instagram_link.to_s.empty? %>
    </div>
    <div class='small-12 medium-8 float-left'>
      <%= content_tag :h1, @product.name, class: 'heading' %>
    </div>
    <div class='small-12 float-left text-wrap'>
      <%= content_tag :div, raw(@product.content), class: 'font-16 product-content' %>
    </div>
    <div class='small-12 buttons-wrap'>
      <div class='small-12 medium-6 float-left'>
        <%= link_to raw("<i class='icon-link'></i> #{t('.official_site')}"), @product.official_site_link, target: '_blank', class: 'button button-primary' unless @product.official_site_link.to_s.empty? %>
        <%= link_to raw("<i class='icon-cart'></i> #{t('.buy')}"), @product.store_link, target: '_blank', class: 'button button-primary' unless @product.store_link.to_s.empty? %>
      </div>
    </div>
  </div>
</div>
<div class='small-12 text-center prev-next'>
  <div class='small-12 medium-6 column float-left'>
    <% if @prev_product %>
      <div class='box float-left'>
        <%= link_to '', @prev_product.path, class: 'icon-arrow-l font-24 float-left'%>
        <div class='product-image-wrap float-left' style='background-image: url(<%= @prev_product.logo_url('original') %>)'>
          <%= link_to @prev_product.path do %>
            <%= image_tag @prev_product.picture_url %>
          <% end %>
        </div>
        <div class='float-left'>
          <%= link_to @prev_product.name, @prev_product.path, class: 'font-20' %>
        </div>
      </div>
    <% end %>
  </div>
  <div class='small-12 medium-6 column float-right'>
    <% if @next_product %>
      <div class='box float-right'>
        <div class='float-left'>
          <%= link_to @next_product.name, @next_product.path, class: 'font-20' %>
        </div>
        <div class='product-image-wrap float-left' style='background-image: url(<%= @next_product.logo_url('original') %>)'>
          <%= link_to @next_product.path do %>
            <%= image_tag @next_product.picture_url %>
          <% end %>
        </div>
        <%= link_to '', @next_product.path, class: 'icon-arrow-r font-24 float-left'%>
      </div>
    <% end %>
  </div>
</div>
</div>