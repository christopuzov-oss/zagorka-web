<%= content_for(:wide) do %> 
  <section class='small-12'>
    <figure class='small-12 wide-banner wallpaper' style="background-image: url(<%= asset_path('categories-fasha.jpg') %>)">  
      <figcaption class='small-12 medium-8 large-6'  data-aos="fade-up">
        <%= content_tag :h1, 'Отворени позиции', class: 'strong font-50' %>
      </figcaption>
      <!--
      <div class='fasha text-right small-12'>
        <i class='icon-logo font-26'></i>
      </div>  
      -->
    </figure>
  </section>
  <%= render partial: '/static_pages/inner_menu', locals: {articles: @articles}%>
  <section class='jobs-wrap small-12 '>
    <div class='row'>
      <% @job_offers.each do |offer| %>
        <div class='small-12 job-offer' data-equalizer>
          <div class='small-4 float-left' data-equalizer-watch>
            <div class='small-12 wallpaper' style="background-image: url(<%= offer.picture_url %>)"></div>
          </div>
          <div class='small-8 float-left column text-wrap' data-equalizer-watch> 
            <%= content_tag :h2, offer.post %>
            <div class='small-12 more'>
              <%= content_tag :span, offer.location, class: 'float-left' %>
              <%= content_tag :span, offer.job_type, class: 'float-left' %>
              <%= link_to 'Научи повече', offer.path, class: 'button button-primary float-right' %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
